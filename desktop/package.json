{
  "name": "dakzo-systems",
  "version": "1.0.0",
  "description": "Dakzo Systems ERP desktop client",
  "main": "main.js",
  "author": {
    "name": "Dakzo Systems"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "node scripts/generate-icons.js",
    "build:msix": "electron-builder --config electron-builder.config.js --win appx --x64",
    "build:installer": "electron-builder --config electron-builder.config.js --win nsis --x64",
    "build:all": "electron-builder --config electron-builder.config.js --win --x64",
    "build:unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.js --win appx --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "cross-env": "^10.0.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.7",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  }
}
