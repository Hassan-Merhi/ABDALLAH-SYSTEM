# Requires a configured offsite rclone remote and age public recipient.
# DO NOT enable timer until a restore into a disposable DB succeeds.
[Unit]
Description=Encrypted offsite PostgreSQL backup for ABDALLAH-SYSTEM
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=PGSSLMODE=disable
EnvironmentFile=/etc/abdallah-system/erp.env
WorkingDirectory=/home/ubuntu/ABDALLAH-SYSTEM
ExecStart=/usr/bin/bash deploy/oracle/backup-to-offsite.sh
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
